# Variables de entorno del backend. Copia este archivo como .env y llena los
# valores reales SOLO en UAT o producción. Nunca subas el .env al repositorio.
# En desarrollo local no hace falta: los valores por defecto de
# application.properties apuntan a 1_Database/compose.yaml.

PORT=8080

DB_URL=jdbc:postgresql://<host>:5432/espacioya
DB_USUARIO=
DB_CONTRASENA=

# URL pública del frontend (origen permitido por CORS)
FRONTEND_URL=
