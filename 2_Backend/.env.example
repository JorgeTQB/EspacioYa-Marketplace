# Variables de entorno del backend. Copia este archivo como .env y llena los
# valores reales SOLO en UAT o producción. Nunca subas el .env al repositorio.
# En desarrollo local no hace falta el .env: los valores por defecto de
# application.properties apuntan a 1_Database/compose.yaml. Las tres llaves
# (CIFRADO_LLAVE, CIFRADO_LLAVE_HUELLA, ALMACENAMIENTO_LLAVE_FIRMA) sí son
# obligatorias también en local: ver README, "2. Backend".

PORT=8080

DB_URL=jdbc:postgresql://<host>:5432/espacioya
DB_USUARIO=
DB_CONTRASENA=

# URL pública del frontend (origen permitido por CORS y base del enlace de recuperación, HU-04)
FRONTEND_URL=

# Correo simulado (HU-04): con true, el enlace de recuperación se escribe en el log.
# Solo desarrollo; nunca true en UAT.
CORREO_SIMULADO_REGISTRAR_ENLACE=false

# Proveedor de correo (HU-25): simulado o smtp. Sin la variable: simulado (no envía nada; UAT usa simulado, D12).
# Para enviar correos reales: CORREO_PROVEEDOR=smtp, un remitente verificado por el proveedor y el host SMTP
# (con smtp, sin remitente o sin host el backend no arranca). El servidor debe aceptar STARTTLS en el puerto.
# Para ensayar sin buzones reales sirve un servidor SMTP de pruebas (Mailtrap, MailHog) con las mismas variables.
# Si la defines, no la dejes vacía: con un valor distinto de smtp o simulado el backend no arranca.
# CORREO_PROVEEDOR=smtp
# Ejemplo: EspacioYa <no-responder@dominio-verificado>
CORREO_REMITENTE=
CORREO_SMTP_HOST=
# Sin la variable: 587 (STARTTLS).
# CORREO_SMTP_PUERTO=587
# Usuario y contraseña (o clave de API SMTP) del proveedor. Nunca se suben al repositorio.
CORREO_SMTP_USUARIO=
CORREO_SMTP_CONTRASENA=

# Cifrado de datos sensibles en reposo (HU-02). 32 bytes en base64, distintas entre sí:
#   openssl rand -base64 32
# Sin ellas el backend no arranca. Guárdalas: si se pierden, los datos cifrados no se recuperan.
CIFRADO_LLAVE=
CIFRADO_LLAVE_HUELLA=

# Almacenamiento privado de documentos y fotos (HU-05).
# Directorio donde se guardan los archivos cifrados: fuera del repositorio y, en UAT, en un
# volumen persistente. Por defecto ./almacenamiento (ignorado por git).
ALMACENAMIENTO_DIRECTORIO=
# Llave que firma las URL de corta duración de los archivos. 32 bytes en base64
# (openssl rand -base64 32), distinta de CIFRADO_LLAVE y CIFRADO_LLAVE_HUELLA.
# Sin ella el backend no arranca.
ALMACENAMIENTO_LLAVE_FIRMA=
# Dónde se guardan los archivos (HU-29): local (disco, el directorio de arriba) o s3 (bucket privado).
# Sin la variable: local, y no hace falta nada de abajo. Si la defines, no la dejes vacía: con un valor distinto
# de local o s3 el backend no arranca. UAT: s3 (las dos réplicas ven los mismos archivos).
# ALMACENAMIENTO_TIPO=s3
# Con s3, obligatorias: nombre del bucket (ya creado, privado y con cifrado SSE-S3; la aplicación no lo crea) y su
# región (en el Learner Lab, us-east-1). Si el bucket no existe o el rol no tiene acceso, el backend no arranca.
# Las credenciales NO van aquí: el SDK usa el rol de la tarea (LabRole en Fargate).
ALMACENAMIENTO_S3_BUCKET=
ALMACENAMIENTO_S3_REGION=

# Panel admin (HU-06). Las rutas /api/admin/** y el inicio de sesión del admin solo se aceptan
# desde estas IPs o rangos CIDR, separados por comas. Vacía = nadie entra. Complementa a MFA
# (HU-17, P3): 0.0.0.0/0,::/0 acepta cualquier IP y deja solo MFA.
# Sin la variable, el valor por defecto es 127.0.0.1,::1 (solo la máquina local).
ADMIN_IPS_PERMITIDAS=
# Expresión regular con las IPs de los proxies de confianza (balanceador, CloudFront). Solo si la
# conexión viene de uno de ellos se usa X-Forwarded-For como IP del cliente. Vacía = ninguno.
PROXIES_CONFIANZA=

# Creación de una cuenta admin por script interno (HU-06). Solo para correr el comando del README
# ("Cuenta de administrador"); nunca dejes ADMIN_CREAR=true ni las credenciales en un .env permanente.
ADMIN_CREAR=false
ADMIN_CORREO=
ADMIN_CONTRASENA=

# Cupo del catálogo público por IP (HU-10): peticiones de búsqueda, ficha y filtros por ventana deslizante.
# Sin la variable: 120 por PT1M (1 minuto, formato ISO-8601). Si la defines, no la dejes vacía: un valor
# vacío no es un número ni una duración y el backend no arranca. Descomenta solo para cambiar el cupo.
# LIMITE_CATALOGO_MAXIMO=120
# LIMITE_CATALOGO_VENTANA=PT1M

# Proceso que expira las reservas sin pago (HU-12). Sin las variables: activo y cada PT1M (1 minuto,
# formato ISO-8601). Si las defines, no las dejes vacías. Descomenta solo para cambiarlas.
# RESERVAS_EXPIRACION_ACTIVA=true
# RESERVAS_EXPIRACION_INTERVALO=PT1M

# Limpieza de los intentos vencidos del limitador (HU-30), compartidos entre réplicas en PostgreSQL. Sin las
# variables: activa y cada PT10M (10 minutos, formato ISO-8601). Si las defines, no las dejes vacías.
# LIMITE_LIMPIEZA_ACTIVA=true
# LIMITE_LIMPIEZA_INTERVALO=PT10M

# Pasarela de pago (HU-13). Obligatoria, también en local: simulada o mercadopago. Vacía o con otro valor, el backend no
# arranca. UAT usa simulada hasta conectar Mercado Pago (D7 revisada, D8): no hay pasarela certificada en ese entorno.
PAGOS_PASARELA=
# Con mercadopago, sin estas tres el backend no arranca. Son credenciales de PRUEBA y nunca se suben al repositorio.
# Llave secreta (Access Token) de las credenciales de prueba del vendedor de prueba.
PAGOS_LLAVE_SECRETA=
# Secreto para verificar la firma del webhook (Tus integraciones > Webhooks > Configurar notificación).
# Con simulada en UAT, déjala VACÍA: la ruta pública del webhook rechaza todo pago y la pantalla simulada es la única
# entrada (S16). Si la defines ahí, quien la conozca puede aprobar pagos de cualquier reserva con curl.
# Solo en local puede llevar un valor, para simular un pago por curl.
PAGOS_SECRETO_WEBHOOK=
# URL pública HTTPS de POST /api/pagos/webhook. Mercado Pago no admite localhost: en local, un túnel.
PAGOS_URL_NOTIFICACION=
# Sin las variables: https://api.mercadopago.com y PT1M (el enlace vence 1 minuto antes que la reserva).
# Si las defines, no las dejes vacías. Descomenta solo para cambiarlas.
# PAGOS_URL_API=https://api.mercadopago.com
# PAGOS_MARGEN_CIERRE=PT1M
# Solo con simulada (HU-16, HU-31): los intentos 1 a N de cada reembolso fallan (por el número de intento guardado en
# la base), también con varias réplicas y tras reiniciar; para probar el reembolso fallido y el botón "Reintentar"
# del admin. Sin la variable: 0 (ninguna falla). Con 1, el reembolso automático (intento 1) falla y el reintento
# (intento 2) funciona. Descomenta solo para la prueba de caja negra.
# PAGOS_SIMULADA_FALLOS_REEMBOLSO=0
