{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar-cierre.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./init.sh)",
      "Bash(./init.sh --rapido)",
      "Bash(./mvnw test)",
      "Bash(./mvnw verify)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm ci)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(./mvnw *)",
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Read(~/.m2/**)",
      "Read(~/AppData/Local/Temp/claude/**)",
      "Bash(./2_Backend/mvnw *)",
      "Bash(npm --prefix 3_frontend *)"
    ],
    "additionalDirectories": [
      "~/.m2/repository"
    ]
  }
}
